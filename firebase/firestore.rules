rules_version = '2';
// Proposed replacement based on the live policy supplied on 2026-10-15.
// Review and test before publishing. This file is not deployed automatically.
service cloud.firestore {
  match /databases/{database}/documents {
    // Preserve profile and transaction access for each signed-in owner.
    // The former global authenticated catch-all is intentionally removed.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /storefronts/{storeId} {
      function owner() { return request.auth != null && request.auth.uid == storeId; }
      function raster(value, limit) {
        return value is string && value.size() <= limit &&
          (value == '' || value.matches('^data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/]+={0,2}$'));
      }
      function validStore(d) {
        return d.keys().hasOnly(['name','description','whatsapp','accent','logo','published','slug','updatedAt']) &&
          d.keys().hasAll(['name','description','whatsapp','accent','logo','published','slug','updatedAt']) &&
          d.slug is string && (d.slug == '' || (d.slug.matches('^[a-z0-9][a-z0-9-]{1,28}[a-z0-9]$') && !(d.slug in reserved()) &&
            getAfter(/databases/$(database)/documents/slugs/$(d.slug)).data.storeId == storeId)) &&
          d.name is string && d.name.size() <= 80 && d.description is string && d.description.size() <= 600 &&
          d.whatsapp is string && (d.whatsapp == '' || d.whatsapp.matches('^[1-9][0-9]{7,14}$')) &&
          d.accent in ['teal','blue','violet'] && raster(d.logo,140000) && d.published is bool &&
          (!d.published || (d.name.size() > 0 && d.whatsapp.size() > 0)) && d.updatedAt == request.time;
      }
      function reserved() {
        return ['admin','api','app','catalog','customers','costs','login','logout','orders','reports','sales','settings','shop','signup','static','www'];
      }
      function choice(values, i) {
        return values.size() <= i || (values[i] is map && values[i].keys().hasOnly(['label','price']) &&
          values[i].keys().hasAll(['label','price']) && values[i].label is string && values[i].label.size() > 0 &&
          values[i].label.size() <= 50 && values[i].price is int && values[i].price >= 0 && values[i].price <= 1000000000);
      }
      function validProduct(d) {
        return d.keys().hasOnly(['name','description','category','price','image','availability','leadTime','optionLabel','options','kind','published','updatedAt']) &&
          d.keys().hasAll(['name','description','category','price','image','availability','leadTime','optionLabel','options','kind','published','updatedAt']) &&
          d.kind in ['physical','digital'] &&
          d.name is string && d.name.size() > 0 && d.name.size() <= 80 && d.description is string && d.description.size() <= 1500 &&
          d.category is string && d.category.size() <= 40 && d.price is int && d.price > 0 && d.price <= 1000000000 && raster(d.image,180000) &&
          d.availability in ['ready','preorder','unavailable'] && d.leadTime is string && d.leadTime.size() <= 100 &&
          (d.availability != 'preorder' || d.leadTime.size() > 0) && d.optionLabel is string && d.optionLabel.size() > 0 && d.optionLabel.size() <= 30 &&
          d.options is list && d.options.size() <= 8 &&
          choice(d.options,0) && choice(d.options,1) && choice(d.options,2) && choice(d.options,3) &&
          choice(d.options,4) && choice(d.options,5) && choice(d.options,6) && choice(d.options,7) &&
          d.published is bool && d.updatedAt == request.time;
      }
      allow get: if owner() || resource.data.published == true;
      allow list: if false;
      allow create, update: if owner() && validStore(request.resource.data);
      allow delete: if owner();
      match /products/{productId} {
        allow read: if owner() || (resource.data.published == true && get(/databases/$(database)/documents/storefronts/$(storeId)).data.published == true);
        allow create, update: if owner() && validProduct(request.resource.data);
        allow delete: if owner();
      }
      match /orders/{orderId} {
        // Rules cap evaluation at 1000 expressions; with these checks 6 items is the most that fits.
        // Reading each required field also fails when a key is missing.
        function orderItem(it) {
          return it.keys().hasOnly(['productId','name','option','kind','unitPrice','quantity','availability','leadTime']) &&
            it.productId is string && it.name is string && it.name.size() > 0 && it.name.size() <= 80 &&
            it.option is string && it.option.size() <= 50 && it.kind in ['physical','digital'] &&
            it.unitPrice is int && it.unitPrice > 0 && it.unitPrice <= 1000000000 &&
            it.quantity is int && it.quantity > 0 && it.quantity < 100 &&
            it.availability in ['ready','preorder'] && it.leadTime is string && it.leadTime.size() <= 100;
        }
        function orderItemAt(items, i) {
          return items.size() <= i || orderItem(items[i]);
        }
        function validOrder(d) {
          return d.keys().hasOnly(['status','progress','buyerName','note','items','subtotal','trackingNo','sellerNote','createdAt','updatedAt']) &&
            d.keys().hasAll(['status','progress','buyerName','note','items','subtotal','trackingNo','sellerNote','createdAt','updatedAt']) &&
            d.status == 'pending' && d.progress == 'pending' && d.trackingNo == '' && d.sellerNote == '' &&
            d.buyerName is string && d.buyerName.size() > 0 && d.buyerName.size() <= 60 &&
            d.note is string && d.note.size() <= 300 &&
            d.items is list && d.items.size() >= 1 && d.items.size() <= 6 &&
            orderItemAt(d.items,0) && orderItemAt(d.items,1) && orderItemAt(d.items,2) && orderItemAt(d.items,3) && orderItemAt(d.items,4) && orderItemAt(d.items,5) &&
            d.subtotal is int && d.subtotal > 0 && d.subtotal <= 100000000000 &&
            d.createdAt == request.time && d.updatedAt == request.time;
        }
        // Anyone holding the unguessable order ID may read it (buyer status page).
        allow get: if true;
        allow list: if owner();
        allow create: if get(/databases/$(database)/documents/storefronts/$(storeId)).data.published == true &&
          validOrder(request.resource.data);
        allow update: if owner() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','progress','trackingNo','sellerNote','updatedAt']) &&
          request.resource.data.status in ['pending','confirmed','rejected'] &&
          (resource.data.status == 'pending' || request.resource.data.status == resource.data.status) &&
          request.resource.data.progress in ['pending','confirmed','packed','shipped','delivered','done','cancelled'] &&
          request.resource.data.trackingNo is string && request.resource.data.trackingNo.size() <= 60 &&
          request.resource.data.sellerNote is string && request.resource.data.sellerNote.size() <= 300 &&
          request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }
    }

    // Readable shop links: slugs/{slug} -> { storeId }. Tied to the storefront's own slug field.
    match /slugs/{slug} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null &&
        request.resource.data.keys().hasOnly(['storeId']) &&
        request.resource.data.storeId == request.auth.uid &&
        getAfter(/databases/$(database)/documents/storefronts/$(request.auth.uid)).data.slug == slug;
      allow delete: if request.auth != null && resource.data.storeId == request.auth.uid;
      allow update: if false;
    }
  }
}
