# Firebase Configuration
# Replace these with your actual Firebase project values
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id
# Subscription (see docs/subscription.md)
# Monthly plan price shown on the upgrade screen, in Rupiah (0 hides the price)
VITE_PLAN_PRICE_IDR=49000
# WhatsApp number the "Upgrade" button contacts, country code without +
VITE_UPGRADE_WHATSAPP=6281298590798
# Optional: mirror of graceEnd() in firestore.rules, ISO date (e.g. 2026-12-31T00:00:00+07:00)
VITE_GRACE_END=
# Shop assistant (optional, see docs/shop-assistant.md)
# Shows the assistant switch to owners and the "Tanya toko" button to buyers
VITE_SHOP_ASSISTANT=
# Server-only Ollama Cloud settings (never prefix these with VITE_)
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b

# Catalogue ingestion: disabled by default. These are NOT deployment approval.
VITE_CATALOGUE_INGESTION=0
CATALOGUE_INGESTION_ENABLED=0
INGESTION_ENABLE_EXTERNAL=0
CATALOGUE_FIREBASE_PROJECT_ID=truly-yours-51176
# Server-only dedicated LarisKu identity via ADC / workload identity; never VITE_.
# GOOGLE_APPLICATION_CREDENTIALS=/private/path/larisku-ingestion.json
# CATALOGUE_OLLAMA_KEY=provided-securely-outside-source
CATALOGUE_OLLAMA_MODEL=gpt-oss:20b
# Explicit unused loopback port for prepared VPS runtime (choose before starting).
# CATALOGUE_PORT=8187
