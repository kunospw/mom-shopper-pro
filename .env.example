# Firebase Configuration
# Replace these with your actual Firebase project values
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id
# Subscription (see docs/subscription.md)
# Monthly plan price shown on the upgrade screen, in Rupiah (0 hides the price)
VITE_PLAN_PRICE_IDR=49000
# WhatsApp number the "Upgrade" button contacts, country code without +
VITE_UPGRADE_WHATSAPP=6281298590798
# Optional: mirror of graceEnd() in firestore.rules, ISO date (e.g. 2026-12-31T00:00:00+07:00)
VITE_GRACE_END=
